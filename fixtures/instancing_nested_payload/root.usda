#usda 1.0
(
    defaultPrim = "Placed"
    doc = """A nested instance introduced by a payload with sub-root targets.

    /Placed instances the payload-backed /Library/Outer prim. Outer contains a
    nested instance whose reference also targets a sub-root prim in another
    layer. The nested prototype must be seeded from its composed prim inside the
    outer prototype so /Placed/Nested/Leaf remains available."""
    metersPerUnit = 1
    upAxis = "Y"
)

def Scope "Library"
{
    def Scope "Outer" (
        payload = @outer.usda@</Root/Library/Outer>
    )
    {
    }
}

def Scope "Placed" (
    instanceable = true
    references = </Library/Outer>
)
{
}
