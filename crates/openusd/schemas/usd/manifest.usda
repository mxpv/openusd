#usda 1.0

def "SchemaBase"
{
    uniform token schemaKind = "abstractBase"
}

def "Typed"
{
    uniform token schemaKind = "abstractBase"
    uniform token[] bases = ["SchemaBase"]
}

def "APISchemaBase"
{
    uniform token schemaKind = "abstractBase"
    uniform token[] bases = ["SchemaBase"]
}

def "ModelAPI"
{
    uniform token schemaKind = "nonAppliedAPI"
    uniform token[] bases = ["APISchemaBase"]
}

def "ColorSpaceAPI"
{
    uniform token schemaKind = "singleApplyAPI"
    uniform token[] bases = ["APISchemaBase"]
}

def "ColorSpaceDefinitionAPI"
{
    uniform token schemaKind = "multipleApplyAPI"
    uniform token[] bases = ["APISchemaBase"]
    uniform token propertyNamespacePrefix = "colorSpaceDefinition"
}

def "CollectionAPI"
{
    uniform token schemaKind = "multipleApplyAPI"
    uniform token[] bases = ["APISchemaBase"]
    uniform token propertyNamespacePrefix = "collection"
}

def "ClipsAPI"
{
    uniform token schemaKind = "nonAppliedAPI"
    uniform token[] bases = ["APISchemaBase"]
}
