# What the tiny library declares beside its schemas, written the way upstream
# writes a plugInfo.json: one metadata field per kind of spec a field can apply
# to, and two kinds. The second plugin has no schema library, and declares
# kinds alone.
{
    "Plugins": [
        {
            "Info": {
                "Kinds": {
                    "tinyGroup": {
                        "baseKind": "group"
                    },
                    "tinyRoot": {}
                },
                "SdfMetadata": {
                    "tinyHints": {
                        "appliesTo": ["prims", "properties"],
                        "documentation": "Free-form hints for a tiny editor.",
                        "type": "dictionary"
                    },
                    "tinyRole": {
                        "appliesTo": ["attributes"],
                        "default": "plain",
                        "type": "token"
                    },
                    "tinyUnits": {
                        "appliesTo": "layers",
                        "default": 1,
                        "type": "double"
                    }
                }
            },
            "Name": "tiny"
        },
        {
            "Info": {
                "Kinds": {
                    "tinyCrowd": {
                        "baseKind": "assembly"
                    },
                    "tinyMarker": {
                        "baseKind": ""
                    },
                    "tinyProp": {
                        "baseKind": "component"
                    }
                }
            },
            "Name": "tinyKinds"
        }
    ]
}
