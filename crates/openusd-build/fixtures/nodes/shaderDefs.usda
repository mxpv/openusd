#usda 1.0

def Shader "UsdTinySurface" (
    doc = "A surface with one colour and a mode."
)
{
    uniform token info:id = "UsdTinySurface"

    token outputs:surface

    color3f inputs:tint = (0.5, 0.5, 0.5) (
        doc = "The surface's colour."
    )

    token inputs:mode = "matte" (
        allowedTokens = ["matte", "gloss"]
        connectability = "interfaceOnly"
    )
}

def Shader "UsdTinyReader_float2" (
    doc = "Reads a two-component primvar."
)
{
    uniform token info:id = "UsdTinyReader_float2"

    string inputs:varname
    float2 inputs:in = (0, 0)
    float2 outputs:result
}

def Scope "NotANode"
{
}
