                float inputs:metalness.connect = </MaterialX/Materials/M_Rook_W/NG_RookWhite.outputs:metalness_output>
                float3 inputs:normal.connect = </MaterialX/Materials/M_Rook_W/NG_RookWhite.outputs:normal_output>
