            )
            {
            }
        }
    }

    def "Shaders"
    {
        def Shader "Rook_B"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            token outputs:surface
        }

        def Shader "Rook_W"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            token outputs:surface
        }
    }

    def "NodeGraphs"
    {
        def NodeGraph "NG_RookBlack"
        {
            color3f outputs:base_color_output.connect = </MaterialX/NodeGraphs/NG_RookBlack/diffuse6.outputs:out>
            float outputs:metalness_output.connect = </MaterialX/NodeGraphs/NG_RookBlack/metallic6.outputs:out>
            float3 outputs:normal_output.connect = </MaterialX/NodeGraphs/NG_RookBlack/mtlxnormalmap8.outputs:out>
            float outputs:roughness_output.connect = </MaterialX/NodeGraphs/NG_RookBlack/roughness6.outputs:out>

            def Shader "diffuse6"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @tex/rook_black_base_color.jpg@ (
                    colorSpace = "srgb_texture"
                )
                color3f outputs:out
            }

            def Shader "metallic6"
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @tex/rook_shared_metallic.jpg@
                float outputs:out
            }

            def Shader "roughness6"
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @tex/rook_shared_roughness.jpg@
                float outputs:out
            }

            def Shader "normal6"
            {
                uniform token info:id = "ND_image_vector3"
                asset inputs:file = @tex/rook_shared_normal.jpg@
                float3 outputs:out
            }

            def Shader "mtlxnormalmap8"
            {
                uniform token info:id = "ND_normalmap_float"
                float3 inputs:in.connect = </MaterialX/NodeGraphs/NG_RookBlack/normal6.outputs:out>
                float3 outputs:out
            }
        }

        def NodeGraph "NG_RookWhite"
        {
            color3f outputs:base_color_output.connect = </MaterialX/NodeGraphs/NG_RookWhite/diffuse7.outputs:out>
            float outputs:metalness_output.connect = </MaterialX/NodeGraphs/NG_RookWhite/metallic7.outputs:out>
            float3 outputs:normal_output.connect = </MaterialX/NodeGraphs/NG_RookWhite/mtlxnormalmap9.outputs:out>
            float outputs:roughness_output.connect = </MaterialX/NodeGraphs/NG_RookWhite/roughness7.outputs:out>

            def Shader "diffuse7"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @tex/rook_white_base_color.jpg@ (
                    colorSpace = "srgb_texture"
                )
                color3f outputs:out
            }

            def Shader "metallic7"
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @tex/rook_shared_metallic.jpg@
                float outputs:out
            }

            def Shader "roughness7"
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @tex/rook_shared_roughness.jpg@
                float outputs:out
            }

            def Shader "normal7"
            {
                uniform token info:id = "ND_image_vector3"
                asset inputs:file = @tex/rook_shared_normal.jpg@
                float3 outputs:out
            }

            def Shader "mtlxnormalmap9"
            {
                uniform token info:id = "ND_normalmap_float"
                float3 inputs:in.connect = </MaterialX/NodeGraphs/NG_RookWhite/normal7.outputs:out>
                float3 outputs:out
            }
        }
    }
}

